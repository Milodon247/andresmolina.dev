{
  "name": "andresmolina-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal CV and portfolio of Andrés Molina Bustamante",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "images": "node scripts/generate-images.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:links": "linkinator dist --verbosity error",
    "test:lighthouse": "lhci autorun",
    "test:quick": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && astro build && npm run test:dist",
    "prepare": "lefthook install",
    "test:all": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run test:dist && npm run test:html && npm run test:links && npm run test:e2e && npm run test:a11y && npm run test:lighthouse",
    "test:smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "lefthook": "2.2.2",
    "linkinator": "8.1.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.9"
    },
    "linkinator": {
      "glob": "14.0.6"
    }
  },
  "allowScripts": {
    "lefthook": false,
    "esbuild": false,
    "workerd": false
  }
}
