---
import '@fontsource-variable/inter';
import '@/styles/global.css';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import Head from '@/components/seo/Head.astro';
import { localeMeta, type Locale } from '@/i18n/config';
import type { PageKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  page?: PageKey | undefined;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | undefined;
}

const { title, description, locale, page, noindex = false, structuredData } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang} dir="ltr">
  <head>
    <Head
      title={title}
      description={description}
      locale={locale}
      page={page}
      noindex={noindex}
      structuredData={structuredData}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-md bg-accent px-4 py-3 font-medium text-on-accent no-underline focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      {t.skipToContent}
    </a>
    <Header locale={locale} page={page} />
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-4xl flex-1 px-4 pt-10 focus:outline-none">
      <slot />
    </main>
    <Footer locale={locale} page={page} />
  </body>
</html>
