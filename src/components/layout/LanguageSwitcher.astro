---
import Icon from '@/components/ui/Icon.astro';
import { localeMeta, otherLocale, type Locale } from '@/i18n/config';
import { pathFor, type PageKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

/**
 * Plain link (no JS) to the same page in the other language. The label is written in the target
 * language and marked with `lang` so screen readers pronounce it correctly.
 */
interface Props {
  locale: Locale;
  /** Current page; when absent (e.g. 404) the link goes to the other locale's home page. */
  page?: PageKey | undefined;
  class?: string;
}

const { locale, page, class: className } = Astro.props;
const target = otherLocale(locale);
const href = pathFor(page ?? 'home', target);
const { htmlLang, label } = localeMeta[target];
const accessibleName = useTranslations(target).switchToThisLanguage;
---

<a
  href={href}
  hreflang={htmlLang}
  lang={htmlLang}
  aria-label={accessibleName}
  class:list={[
    'inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-4 text-sm font-medium text-fg no-underline',
    'transition-colors hover:border-accent hover:bg-surface hover:text-accent',
    className,
  ]}
>
  <Icon name="globe" class="size-4" />
  <span>{label}</span>
</a>
