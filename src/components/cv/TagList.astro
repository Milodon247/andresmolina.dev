---
interface Props {
  /** Accessible label for the list, e.g. "Technologies". */
  label: string;
  items: readonly string[];
}

const { label, items } = Astro.props;
---

{
  items.length > 0 && (
    <ul aria-label={label} class="flex flex-wrap gap-2">
      {items.map((item) => (
        <li class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-muted">{item}</li>
      ))}
    </ul>
  )
}
