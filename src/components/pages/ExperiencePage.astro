---
import { render } from 'astro:content';
import PageIntro from '@/components/cv/PageIntro.astro';
import TagList from '@/components/cv/TagList.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getExperience } from '@/lib/content';
import { currentYearMonth, formatDuration, formatYearMonth, monthsBetween } from '@/lib/dates';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const now = currentYearMonth();
const jobs = await Promise.all(
  (await getExperience(locale)).map(async (job) => ({ job, Content: (await render(job)).Content })),
);
---

<BaseLayout
  title={t.meta.experience.title}
  description={t.meta.experience.description}
  locale={locale}
  page="experience"
>
  <PageIntro heading={t.experience.heading} intro={t.experience.intro} />
  <ol class="relative space-y-10 border-l border-border pl-6 md:pl-8">
    {jobs.map(({ job, Content }) => {
      const { role, company, companyUrl, location, start, end, technologies } = job.data;
      return (
        <li class="relative">
          <span
            class="absolute top-2 -left-[calc(1.5rem+5px)] size-2.5 rounded-full bg-accent md:-left-[calc(2rem+5px)]"
            aria-hidden="true"
          />
          <article class="space-y-3">
            <header>
              <h2 class="text-xl font-semibold tracking-tight">{role}</h2>
              <p class="font-medium">
                {companyUrl ? (
                  <ExternalLink href={companyUrl} locale={locale}>
                    {company}
                  </ExternalLink>
                ) : (
                  company
                )}
                <span class="text-muted"> · {location}</span>
              </p>
              <p class="text-sm text-muted">
                <time datetime={start}>{formatYearMonth(start, locale)}</time>
                {' – '}
                {end ? <time datetime={end}>{formatYearMonth(end, locale)}</time> : t.experience.present}
                {' · '}
                {formatDuration(monthsBetween(start, end ?? now), locale)}
              </p>
            </header>
            <div class="cv-prose">
              <Content />
            </div>
            <TagList label={t.experience.technologies} items={technologies} />
          </article>
        </li>
      );
    })}
  </ol>
</BaseLayout>
