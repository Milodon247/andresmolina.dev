// Cloudflare Workers with Static Assets: a static site, no Worker script.
// Deployed only from GitHub Actions (see .github/workflows); never from a laptop.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "andresmolina-dev",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./dist",
    // /experience → 307 → /experience/, matching the trailing-slash URLs the site links to.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with status 404.
    "not_found_handling": "404-page",
  },
  // Production is served only on the custom domains; Cloudflare creates their DNS records and
  // certificates on deploy. Requires the token permission Zone → Workers Routes → Edit.
  // www is served too (its canonical URLs point to the apex) until a www → apex redirect rule exists.
  "routes": [
    { "pattern": "andresmolina.dev", "custom_domain": true },
    { "pattern": "www.andresmolina.dev", "custom_domain": true },
  ],
  // The main workers.dev route is off: it would duplicate the site under the account subdomain.
  "workers_dev": false,
  // Version and per-PR Preview URLs stay on workers.dev (Cloudflare adds X-Robots-Tag: noindex);
  // wrangler preview needs them.
  "preview_urls": true,
  "previews": {},
  // No telemetry from CI.
  "send_metrics": false,
}
